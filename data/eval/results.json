{
  "schema": 1,
  "datasets": {
    "dedupe-pairs-64": {
      "title": "Synthetic report pairs",
      "provenance": "synthetic",
      "source": "64 hand-written pairs of Biñan report facts (24 same incident, 40 different, including near-identical hard negatives); in this repo at tests/fixtures/dedupe_pairs.json",
      "label_source": "same/different labels written with each pair by the builder, 2026-10-28",
      "n": 64,
      "location": "tests/fixtures/dedupe_pairs.json (text only, no images or audio)"
    },
    "kill-test-25": {
      "title": "Real typhoon photos",
      "provenance": "real",
      "source": "25 Wikimedia Commons photos of Philippine typhoon damage (Haiyan 2013, Ketsana/Ondoy 2009, Rai/Odette 2021) under CC BY 2.0, CC BY-SA 3.0/4.0 or public domain; not from Biñan, mostly severe damage",
      "label_source": "hand labels by the builder for the 2026-10-27 model kill test",
      "n": 25,
      "location": "outside this repo (images are credited in the README, not copied)"
    },
    "synthetic-40": {
      "title": "Synthetic Biñan-style photos",
      "provenance": "synthetic",
      "source": "40 Muse Image photos generated from data/eval/vision_scenes.json (lakeshore streets, GI-sheet roofs, floods ankle- to chest-deep, fish pens, hard negatives), each stamped AI-generated",
      "label_source": "labels designed per scene, then checked against every image by eye on 2026-10-30: 3 labels changed (a roof is visible on the far shore of three fish-pen photos) and 4 borderline labels kept, all noted in label_notes",
      "n": 40,
      "location": "outside this repo (regenerate with scripts.make_vision_set)"
    },
    "screen-messages-60": {
      "title": "Synthetic bot messages",
      "provenance": "synthetic",
      "source": "60 hand-written Telegram-style messages: 30 disaster reports in Tagalog, Taglish and English (very short, typo-heavy, corrections) and 30 non-reports (greetings, tests, laughter, emoji, keyboard mash, ads, spam, a chain message, a joke, unrelated questions); in this repo at data/eval/screen_messages.json",
      "label_source": "report / not_report labels written with each message by the builder, 2026-11-02",
      "n": 60,
      "location": "data/eval/screen_messages.json (text only, synthetic, no real people)"
    },
    "voice-notes-8": {
      "title": "Taglish voice notes",
      "provenance": "real",
      "source": "8 voice notes recorded on a phone by the builder on 2026-10-27 (notes 3-10 of 10; notes 1 and 2 were read from shorter scripts than their references and are left out): one speaker reading written Taglish scripts in the roles of barangay officials, farmers and fisherfolk, with invented names and places. Read speech, not field recordings: no wind, rain, crowd noise or second speaker",
      "label_source": "references are the scripts read, corrected against the audio by the builder on 2026-10-27; place-name labels (8 barangays, 2 sitios) from the same notes' fact labels",
      "n": 8,
      "location": "outside this repo (the builder's own voice: only aggregate metrics are committed)"
    },
    "rice-field-19": {
      "title": "Real rice-field photos",
      "provenance": "real",
      "source": "19 Wikimedia Commons photos of rice fields under CC0, public domain, CC BY 2.0/3.0 or CC BY-SA 3.0/4.0, no people: 7 flooded (3 IRRI photos of Typhoon Ketsana 2009 in the Philippines, Naga and Iriga in Camarines Sur, Odisha, East Kalimantan), 3 lodged (Bulacan, Chiba, Kanagawa) and 9 not damaged, 4 of them irrigated paddies with standing water as hard negatives; not from Biñan",
      "label_source": "field condition and a rough share of the field under open water labeled by eye by the builder on 2026-11-02 (3 borderline photos noted in labels.csv); each file's license and author in credits.json",
      "n": 19,
      "location": "outside this repo (images are credited in the README, not copied)"
    }
  },
