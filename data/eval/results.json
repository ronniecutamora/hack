      "source": "25 Wikimedia Commons photos of Philippine typhoon damage (Haiyan 2013, Ketsana/Ondoy 2009, Rai/Odette 2021) under CC BY 2.0, CC BY-SA 3.0/4.0 or public domain; not from Biñan, mostly severe damage",
      "label_source": "hand labels by the builder for the 2026-10-27 model kill test",
      "n": 25,
      "location": "outside this repo (images are credited in the README, not copied)"
    },
    "synthetic-40": {
      "title": "Synthetic Biñan-style photos",
      "provenance": "synthetic",
      "source": "40 Muse Image photos generated from data/eval/vision_scenes.json (lakeshore streets, GI-sheet roofs, floods ankle- to chest-deep, fish pens, hard negatives), each stamped AI-generated",
      "label_source": "labels designed per scene, then checked against every image by eye on 2026-10-30: 3 labels changed (a roof is visible on the far shore of three fish-pen photos) and 4 borderline labels kept, all noted in label_notes",
      "n": 40,
      "location": "outside this repo (regenerate with scripts.make_vision_set)"
    }
  },
