# Copy to .env and fill in. Never commit .env.
META_API_KEY=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
TELEGRAM_BOT_TOKEN=
# The dev bot (@UlatPH_dev_bot), used by the staging deploy only
TELEGRAM_DEV_BOT_TOKEN=
# Random secret used to pseudonymize Telegram user ids (HMAC). Generate: openssl rand -hex 32
PSEUDONYM_SALT=
# LLMs: muse-spark-1.3, muse-spark-open, muse-spark-open-fireworks, muse-glimmer
AGENT_LLM=muse-spark-1.3
# Omit PAIR_JUDGE_LLM to inherit AGENT_LLM; Glimmer serverless is unverified.
# PAIR_JUDGE_LLM=muse-spark-open-fireworks
INCIDENT_WINDOW_DAYS=14
PAIR_MERGE_THRESHOLD=0.85
# Pair-judge calls per report at most (every candidate up to this many is judged; default 4)
MAX_JUDGED_CANDIDATES=4
DATA_DIR=./var
RAW_MEDIA_TTL_HOURS=24
# Maximum raw-media age in hours while held for the spend cap (default 72; must be >0).
# Blocked reporters use RAW_MEDIA_TTL_HOURS; active assessments are skipped until finished.
HELD_MEDIA_MAX_HOURS=72
MODEL_CACHE=true

# Spam/cost guards (rolling windows; positive limits)
# Maximum reports per rolling hour (default 20)
REPORTS_PER_HOUR=20
# Maximum reports per rolling 24 hours (default 60)
REPORTS_PER_DAY=60
# Recorded estimated USD in the last 24 hours (default 10.0; not a provider billing hard limit)
DAILY_SPEND_CAP_USD=10.0
# EXIF maximum age in days (default 3); 0 allowed. >1 day future is also flagged.
PHOTO_MAX_AGE_DAYS=3
# 64-bit dHash Hamming distance, inclusive (default 6, range 0..64)
PHOTO_HASH_MAX_DISTANCE=6

# Web app host names, comma-separated (Host header, any port); other names get 400 (DNS rebinding).
# Add the deploy host here when the dashboard is published.
ALLOWED_HOSTS=localhost,127.0.0.1

# Officer login (app/auth.py). Leave unset for a localhost-only dev server (no login);
# required on any other host. Passcode: 12+ characters. Session secret: openssl rand -hex 32
OFFICER_PASSCODE=
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Wrong passcodes per client address in a rolling window
LOGIN_FAILURES_PER_WINDOW=10
LOGIN_WINDOW_MINUTES=15
# Behind a TLS proxy (Modal): client address from X-Forwarded-For, Secure cookie
PROXY_HEADERS=false

# Telegram: polling (python -m app.bot, local) or webhook (the web app runs the bot).
# The webhook is registered separately: python -m app.deploy webhook set --target ...
TELEGRAM_MODE=polling
# 32-256 characters of A-Z a-z 0-9 _ - (Telegram echoes it in a header; it also derives the URL path)
TELEGRAM_WEBHOOK_SECRET=

# Database file (default DATA_DIR/app.db) and its snapshots (app/snapshots.py; off when unset)
# DATABASE_PATH=
# SNAPSHOT_DIR=
SNAPSHOT_INTERVAL_MINUTES=2
SNAPSHOT_KEEP=15
SNAPSHOT_KEEP_DAILY=7

# Deploy secrets per target, read by `python -m app.deploy secrets` (generated when empty):
# STAGING_TELEGRAM_WEBHOOK_SECRET=, STAGING_OFFICER_PASSCODE=, STAGING_SESSION_SECRET=,
# STAGING_PSEUDONYM_SALT=, PRODUCTION_TELEGRAM_WEBHOOK_SECRET=, PRODUCTION_OFFICER_PASSCODE=,
# PRODUCTION_SESSION_SECRET=
