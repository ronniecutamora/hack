# Copy to .env and fill in. Never commit .env.
META_API_KEY=
BASETEN_API_KEY=
TELEGRAM_BOT_TOKEN=
# Random secret used to pseudonymize Telegram user ids (HMAC). Generate: openssl rand -hex 32
PSEUDONYM_SALT=
# Agent LLM: muse-spark-1.3 (Meta API) or muse-spark-open (open weights on Baseten)
AGENT_LLM=muse-spark-1.3
DATA_DIR=./var
RAW_MEDIA_TTL_HOURS=24
MODEL_CACHE=true
