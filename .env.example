# Copy to .env and fill in only the values you need. Never commit .env.
# Commented optional settings use the defaults in app/config.py when left unset.
META_API_KEY=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_BOT_TOKEN=
# Generate a pseudonym salt with: openssl rand -hex 32
PSEUDONYM_SALT=

# Agent and incident grouping; PAIR_JUDGE_LLM inherits AGENT_LLM when unset.
# AGENT_LLM=
# PAIR_JUDGE_LLM=
# INCIDENT_WINDOW_DAYS=
# PAIR_MERGE_THRESHOLD=
# MAX_JUDGED_CANDIDATES=

# Data, cache, raw-media retention and optional database snapshots.
# DATA_DIR=
# DATABASE_PATH=
# SNAPSHOT_DIR=
# SNAPSHOT_INTERVAL_MINUTES=
# SNAPSHOT_KEEP=
# SNAPSHOT_KEEP_DAILY=
# MODEL_CACHE=
# RAW_MEDIA_TTL_HOURS=
# HELD_MEDIA_MAX_HOURS=

# Intake, spend and media limits.
# REPORTS_PER_HOUR=
# REPORTS_PER_DAY=
# DAILY_SPEND_CAP_USD=
# PHOTO_MAX_AGE_DAYS=
# PHOTO_HASH_MAX_DISTANCE=
# VIDEO_MAX_SECONDS=
# AUDIO_FILE_MAX_SECONDS=
# VIDEO_KEYFRAMES=

# Comma-separated claim lines. Unset uses app/data/pcic_lines.json; rice is off for Biñan.
# PCIC_COMMODITIES=

# Dashboard and login. Leave secrets empty for a localhost-only development server.
# ALLOWED_HOSTS=
# DASHBOARD_MODE=
OFFICER_PASSCODE=
SESSION_SECRET=
# SESSION_TTL_HOURS=
# LOGIN_FAILURES_PER_WINDOW=
# LOGIN_WINDOW_MINUTES=
# PROXY_HEADERS=

# Telegram mode defaults to polling; webhook mode requires its token, salt and webhook secret.
# TELEGRAM_MODE=
TELEGRAM_WEBHOOK_SECRET=

# Optional per-target deploy secrets, generated when missing by the deployment CLI.
STAGING_TELEGRAM_WEBHOOK_SECRET=
STAGING_OFFICER_PASSCODE=
STAGING_SESSION_SECRET=
STAGING_PSEUDONYM_SALT=
PRODUCTION_TELEGRAM_WEBHOOK_SECRET=
PRODUCTION_OFFICER_PASSCODE=
PRODUCTION_SESSION_SECRET=

# Optional deploy CLI overrides. ULAT_TARGET and ULAT_WORKSPACE are set by the CLI.
# MODAL_BIN=
# MODAL_PYTHON=
# ULAT_TARGET=
# ULAT_WORKSPACE=
