# Copy to .env and fill in. Never commit .env.
META_API_KEY=
BASETEN_API_KEY=
FIREWORKS_API_KEY=
TELEGRAM_BOT_TOKEN=
# Random secret used to pseudonymize Telegram user ids (HMAC). Generate: openssl rand -hex 32
PSEUDONYM_SALT=
# LLMs: muse-spark-1.3, muse-spark-open, muse-spark-open-fireworks, muse-glimmer
AGENT_LLM=muse-spark-1.3
# Omit PAIR_JUDGE_LLM to inherit AGENT_LLM; Glimmer serverless is unverified.
# PAIR_JUDGE_LLM=muse-spark-open-fireworks
INCIDENT_WINDOW_DAYS=14
PAIR_MERGE_THRESHOLD=0.85
DATA_DIR=./var
RAW_MEDIA_TTL_HOURS=24
# Maximum raw-media age in hours while held for the spend cap (default 72; must be >0).
# Blocked reporters use RAW_MEDIA_TTL_HOURS; active assessments are skipped until finished.
HELD_MEDIA_MAX_HOURS=72
MODEL_CACHE=true

# Spam/cost guards (rolling windows; positive limits)
# Maximum reports per rolling hour (default 20)
REPORTS_PER_HOUR=20
# Maximum reports per rolling 24 hours (default 60)
REPORTS_PER_DAY=60
# Recorded estimated USD in the last 24 hours (default 10.0; not a provider billing hard limit)
DAILY_SPEND_CAP_USD=10.0
# EXIF maximum age in days (default 3); 0 allowed. >1 day future is also flagged.
PHOTO_MAX_AGE_DAYS=3
# 64-bit dHash Hamming distance, inclusive (default 6, range 0..64)
PHOTO_HASH_MAX_DISTANCE=6
